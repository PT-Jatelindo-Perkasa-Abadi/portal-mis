<?php
$user = (isset($this->userDetail) && is_array($this->userDetail)) ? $this->userDetail : [];

$rawLevelName = isset($user['level_name']) ? trim($user['level_name']) : '';

// 🎯 1. FORMAT ALIAS LEVEL USER (BE: "Admin MIS" -> FE: "ASP", BE: "IT Provider" -> FE: "Mitra Acquirer")
$displayLevelName = '-';
if (!empty($rawLevelName)) {
    $lvlClean = strtolower($rawLevelName);
    if ($lvlClean === 'admin mis' || $lvlClean === 'mis' || $lvlClean === 'asp') {
        $displayLevelName = 'ASP';
    } elseif ($lvlClean === 'it provider' || $lvlClean === 'mitra acquirer' || $lvlClean === 'mitra') {
        $displayLevelName = 'Mitra Acquirer';
    } else {
        $displayLevelName = $rawLevelName;
    }
}

// 🎯 2. CHECK APAKAH LEVEL USER MERUPAKAN IT PROVIDER / MITRA ACQUIRER
$isItpLevel = (
    strcasecmp($rawLevelName, 'IT Provider') === 0 ||
    strcasecmp($rawLevelName, 'Mitra Acquirer') === 0 ||
    $displayLevelName === 'Mitra Acquirer'
);

$tpCode = isset($this->tpCode) ? $this->tpCode : ($user['tp_code'] ?? null);
$listItp = (isset($this->listItp) && is_array($this->listItp)) ? $this->listItp : [];

$itpNameSelected = '-';
if (!empty($tpCode) && !empty($listItp)) {
    foreach ($listItp as $itp) {
        if ($itp['code'] == $tpCode) {
            $itpNameSelected = $itp['name'];
            break;
        }
    }
}
