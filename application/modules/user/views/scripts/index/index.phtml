            </div>

            <!-- FOOTER PAGINATION DI DALAM KOTAK -->
            <div class="d-flex justify-content-between align-items-center p-4 bg-white">
                <span style="color: #888A8D; font-size: 14px; font-weight: 400;">
                    <?php if (isset($this->users) && $this->users instanceof Zend_Paginator): ?>
                        <?php $pages = $this->users->getPages(); ?>
                        Menampilkan <?= $pages->firstItemNumber; ?> sampai <?= $pages->lastItemNumber; ?> dari <?= $pages->totalItemCount; ?> data
                    <?php else: ?>
                        Menampilkan 0 sampai 0 dari 0 data
                    <?php endif; ?>
                </span>

                <?php if (isset($this->users) && $this->users instanceof Zend_Paginator): ?>
                    <?php
                    $pages = $this->users->getPages();
                    $currentUrl = $this->baseUrl('user/index/index');
                    $queryParams = $_GET;
                    ?>
                    <nav>
                        <ul class="pagination pagination-sm mb-0 gap-1 align-items-center">
                            <li class="page-item <?= (!isset($pages->previous)) ? 'disabled' : ''; ?>">
                                <?php $queryParams['page'] = $pages->first; ?>
                                <a onclick="showLoadingShimmer()" class="page-link bg-white d-flex align-items-center justify-content-center"
                                    style="width: 32px; height: 32px; border: 1px solid #E7E8E8; border-radius: 8px !important; color: #B8B9BB; font-weight: bold; font-size: 12px;"
                                    href="<?= $currentUrl . '?' . http_build_query($queryParams); ?>">&laquo;</a>
                            </li>
                            <li class="page-item <?= (!isset($pages->previous)) ? 'disabled' : ''; ?>">
                                <?php $queryParams['page'] = $pages->previous ?? $pages->first; ?>
                                <a onclick="showLoadingShimmer()" class="page-link bg-white d-flex align-items-center justify-content-center"
                                    style="width: 32px; height: 32px; border: 1px solid #E7E8E8; border-radius: 8px !important; color: #B8B9BB; font-size: 12px;"
                                    href="<?= $currentUrl . '?' . http_build_query($queryParams); ?>">&lsaquo;</a>
                            </li>

                            <?php
                            $totalPage = $pages->pageCount;
                            $currentPage = $pages->current;
                            $range = 1;

                            for ($page = 1; $page <= $totalPage; $page++):
                                if ($page == 1 || $page == $totalPage || ($page >= $currentPage - $range && $page <= $currentPage + $range)):
                                    $queryParams['page'] = $page;
                            ?>
                                    <li class="page-item <?= ($page == $currentPage) ? 'active' : ''; ?>">
                                        <a onclick="showLoadingShimmer()" class="page-link px-0 fw-bold d-flex align-items-center justify-content-center <?= ($page == $currentPage) ? 'text-white' : 'bg-white text-secondary'; ?>"
                                            style="width: 32px; height: 32px; border-radius: 8px !important; <?= ($page == $currentPage) ? 'background: #3A7BF6 !important; border: 1px solid #3A7BF6;' : 'border: 1px solid #E7E8E8; color: #595C60;'; ?> font-size: 14px;"
                                            href="<?= $currentUrl . '?' . http_build_query($queryParams); ?>">
                                            <?= $page; ?>
                                        </a>
                                    </li>
                                <?php
                                elseif (($page == 2 && $currentPage > 3) || ($page == $totalPage - 1 && $currentPage < $totalPage - 2)):
                                ?>
                                    <li class="page-item disabled">
                                        <span class="page-link bg-white text-muted d-flex align-items-center justify-content-center"
                                            style="width: 32px; height: 32px; border: 1px solid #E7E8E8; border-radius: 8px !important; font-size: 14px; color: #B8B9BB !important; cursor: default;">...</span>
                                    </li>
                            <?php
                                endif;
                            endfor;
                            ?>

                            <li class="page-item <?= (!isset($pages->next)) ? 'disabled' : ''; ?>">
                                <?php $queryParams['page'] = $pages->next ?? $pages->last; ?>
                                <a onclick="showLoadingShimmer()" class="page-link bg-white d-flex align-items-center justify-content-center"
                                    style="width: 32px; height: 32px; border: 1px solid #E7E8E8; border-radius: 8px !important; color: #B8B9BB; font-size: 12px;"
                                    href="<?= $currentUrl . '?' . http_build_query($queryParams); ?>">&rsaquo;</a>
                            </li>
                            <li class="page-item <?= (!isset($pages->next)) ? 'disabled' : ''; ?>">
                                <?php $queryParams['page'] = $pages->last; ?>
                                <a onclick="showLoadingShimmer()" class="page-link bg-white d-flex align-items-center justify-content-center"
                                    style="width: 32px; height: 32px; border: 1px solid #E7E8E8; border-radius: 8px !important; color: #B8B9BB; font-weight: bold; font-size: 12px;"
                                    href="<?= $currentUrl . '?' . http_build_query($queryParams); ?>">&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                <?php endif; ?>
            </div>

        </div>

    </div>
</div>

