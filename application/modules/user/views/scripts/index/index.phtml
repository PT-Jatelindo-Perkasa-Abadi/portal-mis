                $currentUrl = $this->baseUrl('user/index/index');
                $queryParams = $_GET;
                ?>
                <nav>
                    <ul class="pagination pagination-sm mb-0 gap-1 align-items-center">
                        <li class="page-item <?= (!isset($pages->previous)) ? 'disabled' : ''; ?>">
                            <?php $queryParams['page'] = $pages->first; ?>
                            <a onclick="showLoadingShimmer()" class="page-link bg-white d-flex align-items-center justify-content-center"
                                style="width: 32px; height: 32px; border: 1px solid #E7E8E8; border-radius: 8px !important; color: #B8B9BB; font-weight: bold; font-size: 12px;"
                                href="<?= $currentUrl . '?' . http_build_query($queryParams); ?>">&laquo;</a>
                        </li>
                        <li class="page-item <?= (!isset($pages->previous)) ? 'disabled' : ''; ?>">
                            <?php $queryParams['page'] = $pages->previous ?? $pages->first; ?>
                            <a onclick="showLoadingShimmer()" class="page-link bg-white d-flex align-items-center justify-content-center"
                                style="width: 32px; height: 32px; border: 1px solid #E7E8E8; border-radius: 8px !important; color: #B8B9BB; font-size: 12px;"
                                href="<?= $currentUrl . '?' . http_build_query($queryParams); ?>">&lsaquo;</a>
                        </li>

                        <?php
                        $totalPage = $pages->pageCount;
                        $currentPage = $pages->current;
                        $range = 1;

                        for ($page = 1; $page <= $totalPage; $page++):
                            if ($page == 1 || $page == $totalPage || ($page >= $currentPage - $range && $page <= $currentPage + $range)):
                                $queryParams['page'] = $page;
                        ?>
                                <li class="page-item <?= ($page == $currentPage) ? 'active' : ''; ?>">
                                    <a onclick="showLoadingShimmer()" class="page-link px-0 fw-bold d-flex align-items-center justify-content-center <?= ($page == $currentPage) ? 'text-white' : 'bg-white text-secondary'; ?>"
                                        style="width: 32px; height: 32px; border-radius: 8px !important; <?= ($page == $currentPage) ? 'background: #3A7BF6 !important; border: 1px solid #3A7BF6;' : 'border: 1px solid #E7E8E8; color: #595C60;'; ?> font-size: 14px;"
                                        href="<?= $currentUrl . '?' . http_build_query($queryParams); ?>">
                                        <?= $page; ?>
                                    </a>
                                </li>
                            <?php
                            elseif (($page == 2 && $currentPage > 3) || ($page == $totalPage - 1 && $currentPage < $totalPage - 2)):
                            ?>
                                <li class="page-item disabled">
                                    <span class="page-link bg-white text-muted d-flex align-items-center justify-content-center"
                                        style="width: 32px; height: 32px; border: 1px solid #E7E8E8; border-radius: 8px !important; font-size: 14px; color: #B8B9BB !important; cursor: default;">...</span>
                                </li>
                        <?php
                            endif;
                        endfor;
                        ?>

                        <li class="page-item <?= (!isset($pages->next)) ? 'disabled' : ''; ?>">
                            <?php $queryParams['page'] = $pages->next ?? $pages->last; ?>
                            <a onclick="showLoadingShimmer()" class="page-link bg-white d-flex align-items-center justify-content-center"
                                style="width: 32px; height: 32px; border: 1px solid #E7E8E8; border-radius: 8px !important; color: #B8B9BB; font-size: 12px;"
                                href="<?= $currentUrl . '?' . http_build_query($queryParams); ?>">&rsaquo;</a>
                        </li>
                        <li class="page-item <?= (!isset($pages->next)) ? 'disabled' : ''; ?>">
                            <?php $queryParams['page'] = $pages->last; ?>
                            <a onclick="showLoadingShimmer()" class="page-link bg-white d-flex align-items-center justify-content-center"
                                style="width: 32px; height: 32px; border: 1px solid #E7E8E8; border-radius: 8px !important; color: #B8B9BB; font-weight: bold; font-size: 12px;"
                                href="<?= $currentUrl . '?' . http_build_query($queryParams); ?>">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            <?php endif; ?>
        </div>

    </div>
</div>

<!-- JAVASCRIPT ACTION INTERACTION -->
<script type="text/javascript">
    // --- FUNGSIONALITAS TOGGLE SHIMMER LOADING ---
    function showLoadingShimmer() {
        document.getElementById('real-table-body')?.classList.add('d-none');
        document.getElementById('shimmer-table-body')?.classList.remove('d-none');
    }

    function hideLoadingShimmer() {
        document.getElementById('shimmer-table-body')?.classList.add('d-none');
        document.getElementById('real-table-body')?.classList.remove('d-none');
    }

    document.addEventListener("DOMContentLoaded", function() {

        // Trigger shimmer ketika form disubmit
        const form = document.getElementById('filterUserForm');
        if (form) {
            form.addEventListener('submit', function() {
                showLoadingShimmer();
            });
        }

        const filterItems = document.querySelectorAll(".dropdown-menu a:not(.limit-item)");

        filterItems.forEach(item => {
            item.addEventListener("click", function(e) {
                e.preventDefault();

                const value = this.getAttribute("data-value");
                const text = this.textContent.trim();

                const dropdownContainer = this.closest(".dropdown");
                const buttonLabel = dropdownContainer.querySelector("button span");

                if (value !== "") {
                    buttonLabel.style.setProperty('color', '#12161C', 'important');
                    buttonLabel.style.fontWeight = "600";
                } else {
                    buttonLabel.style.setProperty('color', '#B8B9BB', 'important');
                    buttonLabel.style.fontWeight = "500";
                }

                buttonLabel.textContent = text;

                if (dropdownContainer.id === "ctx-level") {
                    document.getElementById("input-level").value = value;
                } else if (dropdownContainer.id === "ctx-role") {
                    document.getElementById("input-role").value = value;
                } else if (dropdownContainer.id === "ctx-status") {
                    document.getElementById("input-status").value = value;
                }
            });
        });

        const limitItems = document.querySelectorAll(".dropdown-menu a.limit-item");
        limitItems.forEach(item => {
            item.addEventListener("click", function(e) {
                e.preventDefault();
                const value = this.getAttribute("data-value");

                document.getElementById("label-limit").textContent = value;
                document.getElementById("input-limit").value = value;

                showLoadingShimmer();
                this.closest("form").submit();
            });
        });

        // FIRST LOAD EXECUTION: Tampilkan shimmer 300ms saat halaman dimuat
        setTimeout(function() {
            hideLoadingShimmer();
        }, 300);
    });
</script>