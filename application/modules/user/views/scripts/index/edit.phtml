<?php
$user = (isset($this->userDetail) && is_array($this->userDetail)) ? $this->userDetail : [];

$currentId = isset($user['id']) ? $user['id'] : '';
$currentFullName = isset($user['full_name']) ? $user['full_name'] : '';
$currentEmail = isset($user['email']) ? $user['email'] : '';
$currentLevelName = isset($user['level_name']) ? trim($user['level_name']) : '';
$currentRoleName = isset($user['role_name']) ? trim($user['role_name']) : '';

$isActive = isset($user['is_active']) ? $user['is_active'] : 0;
$isBlocked = isset($user['is_blocked']) ? $user['is_blocked'] : 0;

$statusText = 'Non-Aktif';
$statusVal = '0';
if ($isBlocked == 1) {
    $statusText = 'Blokir';
    $statusVal = 'block';
} elseif ($isActive == 1) {
    $statusText = 'Aktif';
    $statusVal = '1';
}

$levelText = 'Pilih Level User';
$levelVal = '';

if (strcasecmp($currentLevelName, 'Admin MIS') === 0 || strcasecmp($currentLevelName, 'MIS') === 0 || strcasecmp($currentLevelName, 'ASP') === 0) {
    $levelText = 'ASP';
    $levelVal = '1';
} elseif (strcasecmp($currentLevelName, 'IT Provider') === 0 || strcasecmp($currentLevelName, 'Mitra Acquirer') === 0) {
    $levelText = 'Mitra Acquirer';
    $levelVal = '2';
} elseif (strcasecmp($currentLevelName, 'Guest MIS') === 0) {
    $levelText = 'Guest MIS';
    $levelVal = '8';
}

$roleText = 'Pilih Role';
$roleVal = '';
if (strcasecmp($currentRoleName, 'admin') === 0 || strcasecmp($currentRoleName, 'administrator') === 0) {
    $roleText = 'Administrator';
    $roleVal = '2';
} elseif (strcasecmp($currentRoleName, 'viewer') === 0 || strcasecmp($currentRoleName, 'user') === 0) {
    $roleText = 'Viewer';
    $roleVal = '1';
}

$listItp = (isset($this->listItp) && is_array($this->listItp)) ? $this->listItp : [];
$tpCode = isset($this->tpCode) ? $this->tpCode : null;
$itpVisible = ($levelVal === '2');

$itpVal = '';
$itpText = 'Pilih mitra acquirer';
if ($itpVisible && $tpCode !== null) {
    foreach ($listItp as $itp) {
        if ($itp['code'] == $tpCode) {
            $itpVal = $itp['code'];
            $itpText = $itp['name'];
            break;
        }
    }
}
