            if (icon) icon.remove();
        });
        element.classList.add('active');
        element.insertAdjacentHTML('beforeend',
            '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#198754" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>'
            );
    };

    window.selectService = function(val, text, element) {
        document.getElementById('value-service').value = val;

        const labelService = document.getElementById('label-service');
