date_default_timezone_set('Asia/Jakarta');
$hariArray = array("Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu");
$bulanArray = array(
    1 => "Januari",
    "Februari",
    "Maret",
    "April",
    "Mei",
    "Juni",
    "Juli",
    "Agustus",
    "September",
    "Oktober",
    "November",
    "Desember"
);

$activeDate = $this->filters['date'];
$inputDateValue = $activeDate;

if (strpos($activeDate, '/') !== false) {
    $parts = explode('/', $activeDate);
    if (count($parts) == 3) {
        $inputDateValue = $parts[2] . '-' . $parts[1] . '-' . $parts[0];
    }
} else {
    $activeDate = date('d/m/Y', strtotime($inputDateValue));
}

$hariAngka = date('w', strtotime($inputDateValue));
$bulanAngka = date('n', strtotime($inputDateValue));
$tanggalTeksRealtime = $hariArray[$hariAngka] . ", " . date('d', strtotime($inputDateValue)) . " " . $bulanArray[$bulanAngka] . " " . date('Y', strtotime($inputDateValue));

