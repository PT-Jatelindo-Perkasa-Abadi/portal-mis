<?php
date_default_timezone_set('Asia/Jakarta');
$hariArray = array("Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu");
$bulanArray = array(
    1 => "Januari",
    "Februari",
    "Maret",
    "April",
    "Mei",
    "Juni",
    "Juli",
    "Agustus",
    "September",
    "Oktober",
    "November",
    "Desember"
);

$activeDate = $this->filters['date'] ?? '';
$inputDateValue = $activeDate;

$dateForTitle = !empty($activeDate) ? $activeDate : date('Y-m-d');
$titleDateValue = $dateForTitle;

if (strpos($dateForTitle, '/') !== false) {
    $partsTitle = explode('/', $dateForTitle);
    if (count($partsTitle) == 3) {
        $titleDateValue = $partsTitle[2] . '-' . $partsTitle[1] . '-' . $partsTitle[0];
    }
}
$hariAngka = date('w', strtotime($titleDateValue));
$bulanAngka = date('n', strtotime($titleDateValue));
$tanggalTeksRealtime = $hariArray[$hariAngka] . ", " . date('d', strtotime($titleDateValue)) . " " . $bulanArray[$bulanAngka] . " " . date('Y', strtotime($titleDateValue));

if (!empty($activeDate)) {
    if (strpos($activeDate, '/') !== false) {
        $parts = explode('/', $activeDate);
        if (count($parts) == 3) {
            $inputDateValue = $parts[2] . '-' . $parts[1] . '-' . $parts[0];
        }
    } else {
        $activeDate = date('d/m/Y', strtotime($inputDateValue));
    }
    $badgeDateLabel = $activeDate;
} else {
    $inputDateValue = date('Y-m-d');
    $badgeDateLabel = date('d/m/Y');
}

$hasItProviderAccess = ($this->isAllowed('user:index', 'create') || $this->isAllowed('distribution:index', 'it-provider'));

if (!$hasItProviderAccess) {
    $this->activeTab = 'mitra';
} else {
    if (empty($this->activeTab)) {
        $this->activeTab = 'it-provider';
    }
}

// 🎯 LOGIKA BADGE LAYANAN SINKRON DENGAN SEARCH
$activeService = !empty($this->filters['service']) ? strtolower($this->filters['service']) : '';
$searchText    = isset($this->filters['search']) ? strtolower(trim($this->filters['search'])) : '';

$badgeServiceLabel = '';

if ($activeService === 'prepaid') {
    $badgeServiceLabel = 'Prepaid';
} elseif ($activeService === 'postpaid') {
    $badgeServiceLabel = 'Postpaid';
} elseif ($activeService === 'non-taglist') {
    $badgeServiceLabel = 'Non-Taglist';
} elseif (empty($activeService)) {
    $isSearchingService = (
        strpos($searchText, 'prepaid') !== false ||
        strpos($searchText, 'postpaid') !== false ||
        strpos($searchText, 'non') !== false
    );

    if (!$isSearchingService) {
        $badgeServiceLabel = 'Semua Layanan';
    }
}

$defaultTodayDate = date('Y-m-d');
$isUserFiltering = (!empty($inputDateValue) && $inputDateValue !== $defaultTodayDate) ||
    !empty($activeService) ||
    !empty($this->filters['search']);

$isApiError = isset($this->isError) && $this->isError === true;
?>

