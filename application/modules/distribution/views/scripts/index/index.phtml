<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function() {

        // 1. Fungsi Pembantu Interaksi Dropdown Ganti Data & Centang Hijau SVG
        window.selectSort = function(val, text, element) {
            document.getElementById('value-sort-by').value = val;
            document.getElementById('label-sort-by').innerText = text;
            
            element.closest('.dropdown-menu').querySelectorAll('.custom-dropdown-item').forEach(el => {
                el.classList.remove('active');
                const icon = el.querySelector('svg');
                if(icon) icon.remove();
            });
            element.classList.add('active');
            element.insertAdjacentHTML('beforeend', '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#198754" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>');
        };

        window.selectService = function(val, text, element) {
            document.getElementById('value-service').value = val;
            document.getElementById('label-service').innerText = text;
            
            element.closest('.dropdown-menu').querySelectorAll('.custom-dropdown-item').forEach(el => {
                el.classList.remove('active');
                const icon = el.querySelector('svg');
                if(icon) icon.remove();
            });
            element.classList.add('active');
            element.insertAdjacentHTML('beforeend', '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#198754" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>');
        };

        // 2. Render Engine Grafik Batang Chart.js
        const chartRawData = <?= $this->chartJson; ?>;
        const ctx = document.getElementById('distributionBarChart').getContext('2d');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: chartRawData.labels,
                datasets: [{
                        label: 'Prepaid',
                        data: chartRawData.prepaid,
                        backgroundColor: '#B38705', 
                        borderRadius: 2,
                        barThickness: 24, 
                    },
                    {
                        label: 'Postpaid',
                        data: chartRawData.postpaid,
                        backgroundColor: '#FFC107', 
                        borderRadius: 2,
                        barThickness: 24,
                    },
                    {
                        label: 'Non-Taglist',
                        data: chartRawData.non_taglist,
                        backgroundColor: '#FFECB5', 
                        borderRadius: 2,
                        barThickness: 24,
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false } 
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            color: '#595C60',
                            font: { family: 'Sora', size: 12 }
                        },
                        grid: { color: '#E7E8E8', drawBorder: false },
                        afterFit: function(scaleInstance) {
                            scaleInstance.width = 40;
                        }
                    },
                    x: {
                        ticks: {
                            color: '#595C60',
                            font: { family: 'Sora', size: 12, weight: '700' }
                        },
                        grid: { display: false }
                    }
                }
            }
        });
    });
</script>