<!-- ==========================================
     📦 CHART.JS SETUP RENDER
     ========================================== -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function() {
        const chartRawData = <?= $this->chartJson; ?>;
        const ctx = document.getElementById('distributionBarChart').getContext('2d');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: chartRawData.labels,
                datasets: [{
                        label: 'Prepaid',
                        data: chartRawData.prepaid,
                        backgroundColor: '#B38705', // Gold Gelap Figma
                        borderRadius: 2,
                        barThickness: 24, // Sesuai Ukuran Kode Figma
                    },
                    {
                        label: 'Postpaid',
                        data: chartRawData.postpaid,
                        backgroundColor: '#FFC107', // Gold Cerah Figma
                        borderRadius: 2,
                        barThickness: 24,
                    },
                    {
                        label: 'Non-Taglist',
                        data: chartRawData.non_taglist,
                        backgroundColor: '#FFECB5', // Pastel Kuning Pucat Figma
                        borderRadius: 2,
                        barThickness: 24,
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    } // Sembunyikan default legend bawaan canvas
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 500,
                        ticks: {
                            stepSize: 100,
                            color: '#595C60',
                            font: {
                                family: 'Sora',
                                size: 12
                            }
                        },
                        grid: {
                            color: '#E7E8E8',
                            drawBorder: false
                        }
                    },
                    x: {
                        ticks: {
                            color: '#595C60',
                            font: {
                                family: 'Sora',
                                size: 12,
                                weight: '700'
                            }
                        },
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });
    });
</script>