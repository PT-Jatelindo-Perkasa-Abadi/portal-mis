                    backgroundColor: '#3B6FF5',
                    borderWidth: 3,
                    pointRadius: 0
                },
                {
                    label: 'Rata-Rata Request',
                    data: [9, 11, 24, 24, 29, 30, 45],
                    borderColor: '#36D8C5',
                    backgroundColor: '#36D8C5',
                    borderWidth: 3,
                    pointRadius: 0
                },
                {
                    label: 'Rata-Rata Response',
                    data: [7, 9, 17, 19, 25, 31, 35],
                    borderColor: '#19C2F2',
                    backgroundColor: '#19C2F2',
                    borderWidth: 3,
                    pointRadius: 0
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false
            },
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.dataset.label + ' : ' + context.parsed.y + ' ms';
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: {
                        display: false
                    },
                    border: {
                        display: false
                    },
                    ticks: {
                        color: '#666',
                        font: {
                            size: 13
                        }
                    }
                },
                y: {
                    min: 0,
                    max: 50,
                    ticks: {
                        stepSize: 10,
                        color: '#666'
                    },
                    grid: {
                        color: '#E9E9E9',
                        borderDash: [5, 5],
                        drawBorder: false
                    },
                    border: {
                        display: false
                    }
                }
            }
        }
    });

    function loadTransactionChart() {
        transactionChart.showLoading();

        setTimeout(function() {
            const random = Math.floor(Math.random() * 3);
            if (random == 0) {
                transactionChart.update([{
