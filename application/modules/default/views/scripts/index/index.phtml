        }
    });

    function loadLatencyDashboard() {
        latencyChart.showLoading();

        $.ajax({
                url: "<?= $this->baseUrl('/index/latency-chart') ?>",
                type: 'POST',
                dataType: 'json'
            })
            .done(function(response) {
                if (response.status !== 'success') {
                    latencyChart.showError();
                    updateLatencySummary();

                    return;
                }

                renderLatencyChart(response.data);
            })
            .fail(function() {
                latencyChart.showError();
                updateLatencySummary();
            });
    }

    function renderLatencyChart(data) {
        if (!data || !data.chart || !data.chart.datasets.length) {
            latencyChart.showEmpty();
            return;
        }

        updateLatencySummary(data.summary);

        latencyChart.setData(data.chart);
        latencyChart.showChart();
    }

    function updateLatencySummary(summary) {
        const cards = {};

        if (summary) {
            summary.forEach(function(item) {
                cards[item.key] = item;
            });

            $('[data-field=request-latency]')
                .text(`${formatNumber(cards.latency.value)} ms`);

            $('[data-field=request-average]')
                .text(`${formatNumber(cards.rata_rata_request.value)} ms`);

            $('[data-field=response-average]')
                .text(`${formatNumber(cards.rata_rata_rt.value)} ms`);

            return
        }

        $('[data-field=request-latency]').text('-');
        $('[data-field=request-average]').text('-');
        $('[data-field=response-average]').text('-');
    }

    latencyChart.onReload(loadLatencyDashboard);
    loadLatencyDashboard();

    let progressInterval = null;
    let currentRequest = null;

    $('#btnCheckConnection').on('click', function() {
        if ($(this).data('loading')) {
            stopRequest();
            return;
        }

        checkConnection();
    });

    function startLoadingState() {
        $('#btnCheckConnection')
            .data('loading', true)
            .removeClass('btn-primary')
            .addClass('btn-outline-danger')
            .text('Stop');

        $('.card-item-log').removeClass('success');
        $('.card-item-log').addClass('loading');

        startProgressAnimation();
    }

    function successState(data) {
        stopProgressAnimation();

        if (!data.data.msg) {
            errorState();
            return;
        }

        const {
            msg
        } = data.data;

        $('.card-item-log').removeClass('loading');
        $('.card-item-log').addClass('success');
        $('#ping-value').html(msg.latency + ' <span>ms</span>');
        $('#status-value')
            .text('Connected')
            .removeClass('text-danger')
            .addClass('text-success')
            .removeClass('d-none');

        $('#progressBar').css('--progress', '100%');

        resetButton();
    }

    function errorState() {
        stopProgressAnimation();

        $('.card-item-log').removeClass('loading');
        $('.card-item-log').addClass('success');

        $('#ping-value')
            .html('-')
            .removeClass('d-none');

        $('#status-value')
            .text('Disconnected')
            .removeClass('text-success')
            .addClass('text-danger')
            .removeClass('d-none');

        resetButton();
    }

    function resetButton() {
        $('#btnCheckConnection')
            .data('loading', false)
            .removeClass('btn-outline-danger')
            .addClass('btn-primary')
            .text('Cek Koneksi');
    }

    function startProgressAnimation() {
        let progress = 0;

        $('#progressBar')
            .css('--progress', '0%');

        progressInterval = setInterval(function() {
            if (progress < 70) {
                progress += 5;
            } else if (progress < 90) {
                progress += 2;
            } else if (progress < 98) {
                progress += 0.3;
            }

            $('#progressBar')
                .css('--progress', progress + '%');
        }, 120);
    }

    function stopProgressAnimation() {
        clearInterval(progressInterval);

        $('#progressBar').css('--progress', '100%');
    }

    function checkConnection() {
        startLoadingState();

        currentRequest = $.ajax({
            url: '<?= $this->baseUrl('/index/api-log'); ?>',
            method: 'POST',
            dataType: 'json'
        });

        currentRequest.done(function(response) {
            if (response.data != 200) {
                errorState();
                return;
            }

            successState(response);
        });

        currentRequest.fail(function() {
            errorState();
        });
    }

    function stopRequest() {
        if (currentRequest) {
            currentRequest.abort();
        }

        stopProgressAnimation();

        $('#ping-loading').addClass('d-none');
        $('#status-loading').addClass('d-none');

        $('#ping-value')
            .html('-')
            .removeClass('d-none');

        $('#status-value')
            .text('-')
            .removeClass('d-none');

        resetButton();
    }
    <?php endif; ?>
});
</script>
