            $('[data-field=nominal-postpaid]')
                .text(formatCurrencyCompact(cards.POSTPAID.value));

            $('[data-field=nominal-nontaglist]')
                .text(formatCurrencyCompact(cards.NONTAGLIS.value));

            return;
        }

        $('[data-field=nominal-prepaid]').text('-');
        $('[data-field=nominal-postpaid]').text('-');
        $('[data-field=nominal-nontaglist]').text('-');
    }

    function updateServiceSummary(summary) {
        const cards = {};

        if (summary) {
            summary.forEach(function(item) {
                cards[item.key] = item;
            });

            $('[data-field=service-prepaid]')
                .text(formatNumber(cards.PREPAID.value));

            $('[data-field=service-postpaid]')
                .text(formatNumber(cards.POSTPAID.value));

            $('[data-field=service-nontaglist]')
                .text(formatNumber(cards.NONTAGLIS.value));

            return
        }

        $('[data-field=service-prepaid]').text('-');
        $('[data-field=service-postpaid]').text('-');
        $('[data-field=service-nontaglist]').text('-');
    }

    transactionChart.onReload(loadTransactionDashboard);
    serviceChart.onReload(loadTransactionDashboard);

    loadTransactionDashboard();

    <?php if ($this->currentUser['role'] == 'administrator') : ?>
    /** Latency Chart */
    const latencyChart = new DashboardChart({
