<script type="text/javascript">
$(function() {
    $('[data-toggle=filterDate]').on('change', function() {
        $.ajax({
            url: '/index/filter-date',
            type: 'POST',
            data: {
                filterDate: $(this).val()
            },
            success: function(result) {
                if (result.status == 'success') {
                    location.reload();
                }
            },
            error: function() {}
        });
    });

    function loadTotalSummary() {
        const fieldTransaction = $('[data-field="total_transaction"]');
        const fieldSheet = $('[data-field="total_sheet"]');
        const fieldRevenue = $('[data-field="total_revenue"]');

        $.ajax({
            url: "<?= $this->baseUrl('/index/total-summary') ?>",
            type: 'POST',
            dataType: 'json',
            success: function(response) {
                if (!response.data) {
                    fieldTransaction.text('-');
                    fieldSheet.text('-');
                    fieldRevenue.text('-');

                    return;
                }

                if (!Array.isArray(response.data) && typeof response.data !== "object") {
                    fieldTransaction.text('-');
                    fieldSheet.text('-');
                    fieldRevenue.text('-');

                    return;
                }

                const {
                    SUM_NOMINAL_TRANSAKSI,
                    SUM_LEMBAR,
                    SUM_REVENUE
                } = response.data;
                fieldTransaction.text(formatCurrencyCompact(SUM_NOMINAL_TRANSAKSI));
                fieldSheet.text('' + formatNumber(SUM_LEMBAR));
                fieldRevenue.text('' + formatNumber(SUM_REVENUE));
            },
            error: function(error) {
                fieldTransaction.text('-');
                fieldSheet.text('-');
                fieldRevenue.text('-');
            }
        });
    }
    loadTotalSummary();

    function loadAverageTransaction() {
        const fieldAverage = $('[data-field="average-transaction"]');
        const fieldSuccess = $('[data-field="success-transaction"]');
        const fieldPending = $('[data-field="pending-transaction"]');
        const fieldFailed = $('[data-field="failed-transaction"]');

        $.ajax({
            url: "<?= $this->baseUrl('/index/summary-transaction-average') ?>",
            type: 'POST',
            dataType: 'json',
            success: function(response) {
                if (!response.data) {
                    fieldAverage.text('-');
                    fieldSuccess.text('-');
                    fieldPending.text('-');
                    fieldFailed.text('-');
                    return;
                }

                if (!Array.isArray(response.data) && typeof response.data !== "object") {
                    fieldAverage.text('-');
                    fieldSuccess.text('-');
                    fieldPending.text('-');
                    fieldFailed.text('-');
                    return;
                }

                const {
                    SUM_TPS,
                    PERCENTAGE_LUNAS,
                    PERCENTAGE_SUSPECT,
                    PERCENTAGE_BATAL
                } = response.data;

                const valueSuccess = PERCENTAGE_LUNAS != null ? PERCENTAGE_LUNAS + '%' : '-';
                const valuePending = PERCENTAGE_SUSPECT != null ? PERCENTAGE_SUSPECT + '%' : '-';
                const valueFailed = PERCENTAGE_BATAL != null ? PERCENTAGE_BATAL + '%' : '-';

                fieldAverage.html(SUM_TPS +
                    "<span class='fs-7 fw-normal text-neutral-100'> / 1500 (TPS)</span>" ?? "-");
                fieldSuccess.text(valueSuccess);
                fieldPending.text(valuePending);
                fieldFailed.text(valueFailed);
            },
            error: function(error) {
                fieldAverage.text('-');
                fieldSuccess.text('-');
                fieldPending.text('-');
                fieldFailed.text('-');
            }
        });
    }
    loadAverageTransaction();

    /** Transaction Chart */
    const transactionChart = new DashboardChart({
        canvas: '#transactionChart',
        type: 'line',
        autoScaleY: true,
        data: {
            labels: [],
            datasets: []
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    mode: 'index',
                    intersect: false,
                    callbacks: {
                        label(context) {
                            return context.dataset.label +
                                ' : ' +
                                formatCurrencyCompact(
                                    context.parsed.y * 1000000
                                );
                        }
                    }
                }
            },
            interaction: {
                mode: 'nearest',
                intersect: false
            },
            scales: {
                x: {
                    grid: {
                        display: false
                    },
                    border: {
                        display: false
                    }
                },
                y: {
                    beginAtZero: true,
                    grid: {
                        color: '#E8E8E8',
                        borderDash: [5, 5]
                    },
                    border: {
                        display: false
                    },
                    ticks: {
                        callback(value) {
                            return formatCurrencyCompact(value * 1000000);
                        }
                    }
                }
            }
        }
    });

    /** Service Chart */
    const serviceChart = new DashboardChart({
        canvas: '#serviceChart',
        type: 'bar',
        data: {
            labels: [],
            datasets: []
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const value = context.parsed.y;
                            return context.dataset.label + ': ' + formatNumber(value);
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: {
                        display: false
                    },
                    border: {
                        display: false
                    },
                    ticks: {
                        color: '#666',
                        font: {
                            size: 13
                        }
                    }
                },
                y: {
                    min: 0,
                    max: 3000,
                    ticks: {
                        stepSize: 500,
                        color: '#666',
                        callback: function(value) {
                            if (value === 0) {
                                return '0';
                            }
                            if (value === 500) {
                                return '500';
                            }
                            if (value % 1000 === 0) {
                                return (value / 1000) + 'rb';
                            }

                            return (value / 1000).toFixed(1).replace('.0', '') + 'rb';
                        }
                    },
                    grid: {
                        color: '#ECECEC',
                        borderDash: [5, 5],
                        drawBorder: false
                    },
                    border: {
                        display: false
                    }
                }
            }
        }
    });

    function loadTransactionDashboard() {
        transactionChart.showLoading();
        serviceChart.showLoading();

        $.ajax({
                url: "<?= $this->baseUrl('/index/transaction-chart') ?>",
                type: 'POST',
                dataType: 'json'
            })
            .done(function(response) {
                if (response.status !== 'success') {
                    transactionChart.showError();
                    serviceChart.showError();
                    updateNominalSummary();
                    updateServiceSummary();

                    return;
                }

                renderNominalChart(response.data.nominal);
                renderServiceChart(response.data.service);
            })
            .fail(function() {
                transactionChart.showError();
                serviceChart.showError();
                updateNominalSummary();
                updateServiceSummary()
            });
    }

    function renderNominalChart(data) {
        if (!data || !data.chart || !data.chart.datasets.length) {
            transactionChart.showEmpty();
            return;
        }

        updateNominalSummary(data.summary);

        transactionChart.setData(data.chart);
        transactionChart.showChart();
    }

    function renderServiceChart(data) {
        if (!data || !data.chart || !data.chart.datasets.length) {
            serviceChart.showEmpty();
            return;
        }

        updateServiceSummary(data.summary);

        serviceChart.setData(data.chart);
        serviceChart.showChart();
    }

    function updateNominalSummary(summary) {
        const cards = {};

        if (summary) {
            summary.forEach(function(item) {
                cards[item.key] = item;
            });

            $('[data-field=nominal-prepaid]')
