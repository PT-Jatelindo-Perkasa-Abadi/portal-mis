<script type="text/javascript">
$(function() {
    function loadTotalSummary() {
        const fieldTransaction = $('[data-field="total_transaction"]');
        const fieldSheet = $('[data-field="total_sheet"]');

        $.ajax({
            url: "<?= $this->baseUrl('/index/total-summary') ?>",
            type: 'POST',
            dataType: 'json',
            success: function(response) {
                if (!response.data) {
                    fieldTransaction.text('-');
                    fieldSheet.text('-');

                    return;
                }

                if (!Array.isArray(response.data) && typeof response.data !== "object") {
                    fieldTransaction.text('-');
                    fieldSheet.text('-');

                    return;
                }

                const {
                    SUM_NOMINAL_TRANSAKSI,
                    SUM_LEMBAR
                } = response.data;
                fieldTransaction.text(formatCurrencyCompact(SUM_NOMINAL_TRANSAKSI));
                fieldSheet.text('' + formatNumber(SUM_LEMBAR));
            },
            error: function(error) {}
        });
    }
    loadTotalSummary();

    function loadAverageTransaction() {
        const fieldAverage = $('[data-field="average_transaction"]');
        const fieldSuccess = $('[data-field="success_transaction"]');
        const fieldPending = $('[data-field="pending_transaction"]');
        const fieldFailed = $('[data-field="failed_transaction"]');

        $.ajax({
            url: "<?= $this->baseUrl('/index/summary-transaction-average') ?>",
            type: 'POST',
            dataType: 'json',
            success: function(response) {
                if (!response.data) {
                    fieldTransaction.text('-');
                    fieldSheet.text('-');

                    return;
                }

                if (!Array.isArray(response.data) && typeof response.data !== "object") {
                    fieldTransaction.text('-');
                    fieldSheet.text('-');

                    return;
                }

                const {
                    SUM_TPS,
                    PERCENTAGE_LUNAS,
                    PERCENTAGE_SUSPECT,
                    PERCENTAGE_BATAL
                } = response.data;

                const valueSuccess = PERCENTAGE_LUNAS != null ? PERCENTAGE_LUNAS + '%' : '-';
                const valuePending = PERCENTAGE_SUSPECT != null ? PERCENTAGE_SUSPECT + '%' : '-';
                const valueFailed = PERCENTAGE_BATAL != null ? PERCENTAGE_BATAL + '%' : '-';

                fieldAverage.html(SUM_TPS +
                    "<span class='fs-7 fw-normal text-neutral-100'> / 1500 (TPS)</span>" ?? "-");
                fieldSuccess.text(valueSuccess);
                fieldPending.text(valuePending);
                fieldFailed.text(valueFailed);
            },
            error: function(error) {}
        });
    }
    loadAverageTransaction();

    const transactionChart = new DashboardChart({
        canvas: '#transactionChart',
        type: 'line',
        data: {
            labels: [
                '09:00',
                '10:00',
                '11:00',
                '12:00',
                '13:00',
                '14:00',
                '15:00'
            ],
            datasets: [{
                    label: 'Prepaid',
                    data: [200, 260, 305, 410, 485, 520, 545],
                    borderColor: '#A97800',
                    backgroundColor: '#A97800',
                    borderWidth: 3,
                    pointRadius: 0
                },
                {
                    label: 'Postpaid',
                    data: [90, 205, 255, 330, 435, 450, 450],
                    borderColor: '#F5B400',
                    backgroundColor: '#F5B400',
                    borderWidth: 3,
                    pointRadius: 0
                },
                {
                    label: 'Non-Taglist',
                    data: [70, 125, 125, 150, 215, 235, 275],
                    borderColor: '#F6D98A',
                    backgroundColor: '#F6D98A',
                    borderWidth: 3,
                    pointRadius: 0
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    mode: 'index',
                    intersect: false,
                    callbacks: {
                        label: function(context) {
                            return context.dataset.label + ' : ' + context.parsed.y;
                        }
                    }
                }
            },
            interaction: {
                mode: 'nearest',
                intersect: false
            },
            scales: {
                x: {
                    grid: {
                        display: false,
                        drawBorder: false
                    },
                    border: {
                        display: false
                    },
                    ticks: {
                        color: '#666',
                        font: {
                            size: 13
                        }
                    }
                },
                y: {
                    min: 0,
                    max: 600,
                    ticks: {
                        stepSize: 100,
                        color: '#666',
                        callback: function(value) {
                            if (value === 0) {
                                return '0';
                            }

                            return value + 'Jt';
                        }
                    },
                    grid: {
                        color: '#E8E8E8',
                        borderDash: [5, 5],
                        drawBorder: false
                    },
                    border: {
                        display: false,
                        dash: [5, 5],
                        dashOffset: 5,
                    },
                }
            }
        }
    });

    const serviceChart = new DashboardChart({
        canvas: '#serviceChart',
        type: 'bar',
        data: {
            labels: [
                '10:00',
                '11:00',
                '12:00',
                '13:00',
                '14:00'
            ],
            datasets: [{
                    label: 'Prepaid',
                    data: [1200, 1200, 1650, 1800, 2200],
                    backgroundColor: '#B98900',
                    borderRadius: 4,
                    barPercentage: .75,
                    categoryPercentage: .6
                },
                {
                    label: 'Postpaid',
                    data: [800, 800, 1200, 1200, 1800],
                    backgroundColor: '#FFC107',
                    borderRadius: 4,
                    barPercentage: .75,
                    categoryPercentage: .6
                },
                {
                    label: 'Non-Taglis',
                    data: [500, 600, 750, 800, 1000],
                    backgroundColor: '#FBE5A5',
                    borderRadius: 4,
                    barPercentage: .75,
                    categoryPercentage: .6
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const value = context.parsed.y;
                            // if (value >= 1000) {
                            //     return context.dataset.label + ': ' + (value / 1000).toFixed(1)
                            //         .replace('.0', '');
                            // }
                            return context.dataset.label + ': ' + value;
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: {
                        display: false
                    },
                    border: {
                        display: false
                    },
                    ticks: {
                        color: '#666',
                        font: {
                            size: 13
                        }
                    }
                },
                y: {
                    min: 0,
                    max: 3000,
                    ticks: {
                        stepSize: 500,
                        color: '#666',
                        callback: function(value) {
                            if (value === 0) {
                                return '0';
                            }
                            if (value === 500) {
                                return '500';
                            }
                            if (value % 1000 === 0) {
                                return (value / 1000) + 'rb';
                            }

                            return (value / 1000).toFixed(1).replace('.0', '') + 'rb';
                        }
                    },
                    grid: {
                        color: '#ECECEC',
